      "encode": {
        "enter": {
          "y": {
            "value": 235
          },
          "font": {
            "value": "Times New Roman"
          },
          "fontSize": {
            "value": 20
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#ffffff"
          },
          "baseline": {
            "value": "middle"
          }
        },
        "update": {
          "x": {
            "field": "x"
          },
          "text": {
            "field": "header"
          }
        }
      }
    },

    {
      "name": "rowBackgrounds",
      "type": "rect",
      "from": {
        "data": "rawAlerts"
      },
      "encode": {
        "enter": {
          "x": {
            "value": 50
          },
          "width": {
            "value": 3996
          },
          "height": {
            "signal": "rowHeight"
          }
        },
        "update": {
          "y": {
            "signal": "270 + (datum.row_number - 1) * rowHeight"
          },
          "fill": [
            {
              "test": "selectedRow === datum.row_number",
              "value": "#ff3366"
            },
            {
              "test": "datum.row_number % 2 === 0",
              "value": "#1a202c"
            },
            {
              "value": "#2d3748"
            }
          ],
          "stroke": [
            {
              "test": "selectedRow === datum.row_number",
              "value": "#ff6b6b"
            },
            {
              "value": "#374151"
            }
          ],
          "strokeWidth": [
            {
              "test": "selectedRow === datum.row_number",
              "value": 2
            },
            {
              "value": 1
            }
          ]
        }
      }
    },

