    {
      "name": "rowBackgrounds",
      "type": "rect",
      "from": {
        "data": "rawAlerts"
      },
      "encode": {
        "enter": {
          "x": {
            "value": 0
          },
          "width": {
            "signal": "width"
          },
          "height": {
            "signal": "rowHeight"
          },
          "cornerRadius": {
            "value": 4
          },
          "cursor": {
            "value": "pointer"
          }
        },
        "update": {
          "y": {
            "signal": "headerHeight + 130 + (datum.row_number - 1) * rowHeight"
          },
          "fill": [
            {
              "test": "datum.row_number === selectedRow",
              "value": "#26384a"
            },
            {
              "test": "datum.row_number % 2 === 0",
              "value": "#111820"
            },
            {
              "value": "#0d131a"
            }
          ]
        }
      }
    },

