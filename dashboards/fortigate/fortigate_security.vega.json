{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "FortiGate Security Dashboard - Firewall Events, Traffic, Authentication and VPN Activity",
  "width": 4096,
  "height": 2160,
  "padding": 50,
  "autosize": "none",
  "background": "#0a0e14",

  "signals": [
    {
      "name": "rowHeight",
      "value": 55
    },
    {
      "name": "headerHeight",
      "value": 70
    },
    {
      "name": "selectedRow",
      "value": null,
      "on": [
        {
          "events": "@rowBackgrounds:click",
          "update": "datum.row_number"
        }
      ]
    }
  ],

  "data": [
    {
      "name": "rawAlerts",
      "url": {
        "index": "wazuh-alerts-*",
        "body": {
          "size": 35,
          "sort": [
            {
              "timestamp": {
                "order": "desc"
              }
            }
          ],
          "query": {
            "bool": {
              "must": [
                {
                  "term": {
                    "decoder.name": "fortinet-fortigate-firewall"
                  }
                },
                {
                  "range": {
                    "timestamp": {
                      "gte": "now-24h",
                      "lte": "now"
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      },
      "transform": [
        {
          "type": "formula",
          "as": "timestamp",
          "expr": "datum._source.timestamp ? datum._source.timestamp : 'N/A'"
        },

        {
          "type": "formula",
          "as": "firewall",
          "expr": "datum._source.data && datum._source.data.devname ? datum._source.data.devname : 'N/A'"
        },

        {
          "type": "formula",
          "as": "severity",
          "expr": "datum._source.data && datum._source.data.level ? datum._source.data.level : (datum._source.rule && datum._source.rule.level ? toString(datum._source.rule.level) : 'N/A')"
        },

        {
          "type": "formula",
          "as": "type",
          "expr": "datum._source.data ? ((datum._source.data.type ? datum._source.data.type : '') + (datum._source.data.type && datum._source.data.subtype ? ' / ' : '') + (datum._source.data.subtype ? datum._source.data.subtype : '')) : 'N/A'"
        },

        {
          "type": "formula",
          "as": "event",
          "expr": "datum._source.data && datum._source.data.msg ? datum._source.data.msg : (datum._source.data && datum._source.data.logdesc ? datum._source.data.logdesc : (datum._source.rule && datum._source.rule.description ? datum._source.rule.description : 'N/A'))"
        },

        {
          "type": "formula",
          "as": "source_ip",
          "expr": "datum._source.data ? (datum._source.data.srcip ? datum._source.data.srcip : (datum._source.data.remip ? datum._source.data.remip : 'N/A')) : 'N/A'"
        },

        {
          "type": "formula",
          "as": "destination_ip",
          "expr": "datum._source.data ? (datum._source.data.dstip ? datum._source.data.dstip : (datum._source.data.locip ? datum._source.data.locip : 'N/A')) : 'N/A'"
        },

        {
          "type": "formula",
          "as": "user",
          "expr": "datum._source.data ? (datum._source.data.dstuser ? datum._source.data.dstuser : (datum._source.data.user ? datum._source.data.user : 'N/A')) : 'N/A'"
        },

        {
          "type": "formula",
          "as": "action",
          "expr": "datum._source.data && datum._source.data.action ? datum._source.data.action : 'N/A'"
        },

        {
          "type": "formula",
          "as": "service",
          "expr": "datum._source.data && datum._source.data.service ? datum._source.data.service : 'N/A'"
        },

        {
          "type": "formula",
          "as": "protocol",
          "expr": "datum._source.data && datum._source.data.proto != null ? (datum._source.data.proto == 6 ? 'TCP' : datum._source.data.proto == 17 ? 'UDP' : toString(datum._source.data.proto)) : 'N/A'"
        },

        {
          "type": "window",
          "ops": [
            "row_number"
          ],
          "as": [
            "row_number"
          ]
        }
      ]
    }
  ],

